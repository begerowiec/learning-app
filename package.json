{
  "name": "loop",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Loop — content-driven, spaced-repetition learning app (English, Python, TypeScript).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/make-icons.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "node --import tsx tests/e2e/run.ts",
    "verify": "npm run sync:content && npm run typecheck && npm run validate:content && npm run test && npm run build && npm run test:e2e",
    "sync:content": "node scripts/generate-source.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "playwright": "^1.56.0",
    "tsx": "^4.21.0",
    "typescript": ">=5.6 <7"
  }
}
